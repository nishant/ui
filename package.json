{
  "name": "@nish/ui",
  "version": "1.0.2",
  "description": "Design tokens, theme switching and React components shared by every *.nish.software app.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tsconfig"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "inbox-client": [
        "./dist/inbox-client.d.ts"
      ],
      "vite": [
        "./dist/node/vite.d.ts"
      ],
      "eslint": [
        "./dist/node/eslint.d.ts"
      ],
      "server": [
        "./dist/server/index.d.ts"
      ],
      "server/hono": [
        "./dist/server/hono.d.ts"
      ]
    }
  },
  "bin": {
    "nish-th-check": "./dist/node/th-check.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./inbox-client": {
      "types": "./dist/inbox-client.d.ts",
      "import": "./dist/inbox-client.js",
      "default": "./dist/inbox-client.js"
    },
    "./vite": {
      "types": "./dist/node/vite.d.ts",
      "import": "./dist/node/vite.js",
      "default": "./dist/node/vite.js"
    },
    "./eslint": {
      "types": "./dist/node/eslint.d.ts",
      "import": "./dist/node/eslint.js",
      "default": "./dist/node/eslint.js"
    },
    "./tsconfig/*": "./tsconfig/*",
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./server/hono": {
      "types": "./dist/server/hono.d.ts",
      "import": "./dist/server/hono.js",
      "default": "./dist/server/hono.js"
    },
    "./theme-init.js": "./dist/theme-init.js",
    "./theme.global.js": "./dist/theme.global.js",
    "./tailwind.css": "./dist/tailwind.css",
    "./nish.css": "./dist/nish.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./base.css": "./dist/base.css",
    "./nish-components.css": "./dist/nish-components.css",
    "./fonts/*": "./dist/fonts/*",
    "./files.json": "./dist/files.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && vite --config demo/vite.config.ts",
    "dev:site": "npm run build && vite --config site/vite.config.ts",
    "build:site": "npm run build && vite build --config site/vite.config.ts",
    "preview:site": "vite preview --config site/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "contrast": "node tools/contrast.mjs",
    "check": "npm run typecheck && npm run contrast && npm run build && node tools/format-check.mjs && node tools/inbox-client-check.mjs && node tools/canvas-layout-check.mjs && npm run th-check && npm run lint",
    "visual": "node tools/visual-check.mjs",
    "release": "node scripts/release.mjs",
    "test:tools": "node --test tools/*.test.mjs tools/fanout/*.test.mjs",
    "test:unit": "vitest run",
    "test:overlay": "playwright test",
    "th-check": "node dist/node/th-check.js src site demo"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "hono": ">=4",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.14",
    "jiti": "^2.7.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  }
}
