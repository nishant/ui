{
  "name": "@nish/ui",
  "version": "0.2.6",
  "description": "Design tokens, theme switching and React components shared by every *.nish.software app.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./theme-init.js": "./dist/theme-init.js",
    "./theme.global.js": "./dist/theme.global.js",
    "./tailwind.css": "./dist/tailwind.css",
    "./nish.css": "./dist/nish.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./base.css": "./dist/base.css",
    "./nish-components.css": "./dist/nish-components.css",
    "./fonts/*": "./dist/fonts/*",
    "./files.json": "./dist/files.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && vite --config demo/vite.config.ts",
    "dev:site": "npm run build && vite --config site/vite.config.ts",
    "build:site": "npm run build && vite build --config site/vite.config.ts",
    "preview:site": "vite preview --config site/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "contrast": "node tools/contrast.mjs",
    "check": "npm run typecheck && npm run contrast && npm run build",
    "visual": "node tools/visual-check.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
