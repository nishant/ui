{
  "name": "@nish/ui",
  "version": "2.1.1",
  "description": "Design tokens, seven themes, flash-free theme switching and accessible React 19 components for Tailwind 4, plain CSS and static HTML. Live docs: https://design.nish.software",
  "license": "MIT",
  "author": "Nishant Arora",
  "homepage": "https://design.nish.software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nishant/ui.git"
  },
  "bugs": {
    "url": "https://github.com/nishant/ui/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "ui",
    "components",
    "react",
    "react-components",
    "tailwindcss",
    "tailwind",
    "tailwindcss-v4",
    "themes",
    "theming",
    "dark-mode",
    "css-variables",
    "accessibility",
    "a11y",
    "vite"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/elements.js",
    "./dist/elements-*.js",
    "./dist/theme-init.js",
    "./dist/theme.global.js"
  ],
  "files": [
    "dist",
    "!dist/esm/**/*.map",
    "!dist/**/*.map",
    "tsconfig"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "theme": [
        "./dist/theme.d.ts"
      ],
      "tokens": [
        "./dist/tokens.d.ts"
      ],
      "system-canvas": [
        "./dist/system-canvas.d.ts"
      ],
      "inbox": [
        "./dist/inbox.d.ts"
      ],
      "service-tokens": [
        "./dist/service-tokens.d.ts"
      ],
      "chart": [
        "./dist/chart.d.ts"
      ],
      "format": [
        "./dist/format.d.ts"
      ],
      "split-layout": [
        "./dist/split-layout.d.ts"
      ],
      "inbox-client": [
        "./dist/inbox-client.d.ts"
      ],
      "elements": [
        "./dist/elements.d.ts"
      ],
      "elements/forms": [
        "./dist/elements-forms.d.ts"
      ],
      "elements/data": [
        "./dist/elements-data.d.ts"
      ],
      "elements/charts": [
        "./dist/elements-charts.d.ts"
      ],
      "elements/all": [
        "./dist/elements-all.d.ts"
      ],
      "vite": [
        "./dist/node/vite.d.ts"
      ],
      "eslint": [
        "./dist/node/eslint.d.ts"
      ],
      "server": [
        "./dist/server/index.d.ts"
      ],
      "server/hono": [
        "./dist/server/hono.d.ts"
      ]
    }
  },
  "bin": {
    "nish-th-check": "./dist/node/th-check.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/esm/theme.js",
      "default": "./dist/esm/theme.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/esm/tokens.mjs",
      "default": "./dist/esm/tokens.mjs"
    },
    "./system-canvas": {
      "types": "./dist/system-canvas.d.ts",
      "import": "./dist/esm/system-canvas.js",
      "default": "./dist/esm/system-canvas.js"
    },
    "./inbox": {
      "types": "./dist/inbox.d.ts",
      "import": "./dist/esm/inbox.js",
      "default": "./dist/esm/inbox.js"
    },
    "./service-tokens": {
      "types": "./dist/service-tokens.d.ts",
      "import": "./dist/esm/service-tokens.js",
      "default": "./dist/esm/service-tokens.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/esm/chart.js",
      "default": "./dist/esm/chart.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/esm/format.js",
      "default": "./dist/esm/format.js"
    },
    "./split-layout": {
      "types": "./dist/split-layout.d.ts",
      "import": "./dist/esm/split-layout.js",
      "default": "./dist/esm/split-layout.js"
    },
    "./inbox-client": {
      "types": "./dist/inbox-client.d.ts",
      "import": "./dist/esm/inbox-client.js",
      "default": "./dist/esm/inbox-client.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "default": "./dist/elements.js"
    },
    "./elements/forms": {
      "types": "./dist/elements-forms.d.ts",
      "import": "./dist/elements-forms.js",
      "default": "./dist/elements-forms.js"
    },
    "./elements/data": {
      "types": "./dist/elements-data.d.ts",
      "import": "./dist/elements-data.js",
      "default": "./dist/elements-data.js"
    },
    "./elements/charts": {
      "types": "./dist/elements-charts.d.ts",
      "import": "./dist/elements-charts.js",
      "default": "./dist/elements-charts.js"
    },
    "./elements/all": {
      "types": "./dist/elements-all.d.ts",
      "import": "./dist/elements-all.js",
      "default": "./dist/elements-all.js"
    },
    "./vite": {
      "types": "./dist/node/vite.d.ts",
      "import": "./dist/node/vite.js",
      "default": "./dist/node/vite.js"
    },
    "./eslint": {
      "types": "./dist/node/eslint.d.ts",
      "import": "./dist/node/eslint.js",
      "default": "./dist/node/eslint.js"
    },
    "./tsconfig/*": "./tsconfig/*",
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./server/hono": {
      "types": "./dist/server/hono.d.ts",
      "import": "./dist/server/hono.js",
      "default": "./dist/server/hono.js"
    },
    "./theme-init.js": "./dist/theme-init.js",
    "./theme-init.sha256": "./dist/theme-init.sha256",
    "./theme.global.js": "./dist/theme.global.js",
    "./tailwind.css": "./dist/tailwind.css",
    "./tailwind-core.css": "./dist/tailwind-core.css",
    "./nish.css": "./dist/nish.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./base.css": "./dist/base.css",
    "./nish-components.css": "./dist/nish-components.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens.dtcg.json": "./dist/tokens.dtcg.json",
    "./fonts/*": "./dist/fonts/*",
    "./files.json": "./dist/files.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && vite --config demo/vite.config.ts",
    "dev:site": "npm run build && vite --config site/vite.config.ts",
    "mutation": "npm install --no-save --no-audit --no-fund @stryker-mutator/core@10.1.1 @stryker-mutator/vitest-runner@10.1.1 && stryker run stryker.config.mjs",
    "build:site": "npm run build && vite build --config site/vite.config.ts && node tools/site-bundle-check.mjs",
    "preview:site": "vite preview --config site/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "contrast": "node tools/contrast.mjs",
    "check": "npm run typecheck && npm run contrast && npm run build && node tools/format-check.mjs && node tools/elements-check.mjs && node tools/inbox-client-check.mjs &&node tools/canvas-layout-check.mjs && node tools/canvas-route-check.mjs && node tools/canvas-route-bench.mjs --check && npm run th-check && npm run lint && npm run size",
    "visual": "node tools/visual-check.mjs",
    "release": "node scripts/release.mjs",
    "test:tools": "node --test tools/*.test.mjs tools/fanout/*.test.mjs",
    "test:unit": "vitest run",
    "test:overlay": "playwright test",
    "th-check": "node dist/node/th-check.js src site demo",
    "size": "node tools/size-check.mjs",
    "test:consumers": "node tools/consumer-check.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "hono": ">=4",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.14",
    "jiti": "^2.7.0",
    "lightningcss": "^1.32.0",
    "lit": "^3.3.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "follow-redirects": "^1.16.2"
  }
}
